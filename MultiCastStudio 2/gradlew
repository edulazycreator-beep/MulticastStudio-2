#!/usr/bin/env sh
# Lightweight Gradle bootstrap launcher for this starter project.
# It downloads the pinned Gradle distribution on first use (official wrapper JAR is not bundled).
set -eu
GRADLE_VERSION="9.5.0"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
DIST_ROOT="$GRADLE_USER_HOME/manual-dists"
GRADLE_HOME="$DIST_ROOT/gradle-$GRADLE_VERSION"
GRADLE_BIN="$GRADLE_HOME/bin/gradle"

if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$DIST_ROOT"
  ARCHIVE="$DIST_ROOT/gradle-$GRADLE_VERSION-bin.zip"
  URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
  echo "Gradle $GRADLE_VERSION not found. Downloading pinned distribution..."
  if command -v curl >/dev/null 2>&1; then
    curl -fL "$URL" -o "$ARCHIVE"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$ARCHIVE" "$URL"
  else
    echo "Please install curl or wget to download Gradle." >&2
    exit 1
  fi
  if ! command -v unzip >/dev/null 2>&1; then
    echo "Please install unzip to extract Gradle." >&2
    exit 1
  fi
  unzip -q -o "$ARCHIVE" -d "$DIST_ROOT"
  rm -f "$ARCHIVE"
fi

exec "$GRADLE_BIN" "$@"
